# Path: app/.env.example
# MCP AI Companion Demo — sample environment variables for the custom LLM service

# Primary LLM configuration (DashScope by default)
# Replace with your real API key before running `custom_llm_service.py` or `main.py`.
DASHSCOPE_API_KEY=your_dashscope_api_key
LLM_MODEL=qwen-flash

# Token used by the HTTP streaming service for Bearer authentication.
# Generate a strong random string (e.g., `openssl rand -hex 16`) and share it with clients.
# When using the Volc proxy, set VOLC_LLM_API_KEY in volc-server/.env to the same value.
CUSTOM_LLM_API_KEY=your_custom_llm_token

# MQTT broker configuration (app connects as MCP client)
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
# Optional: override MCP discovery/presence settings
MCP_SERVER_NAME_PREFIX=
MCP_SERVER_DISCOVERY_FILTER=
MCP_REGISTRY_CLIENT_NAME=

# Optional HTTPS (used by compose if set)
# APP_SSL_CERTFILE=/certs/fullchain.pem
# APP_SSL_KEYFILE=/certs/key.pem

# Optional directory for storing uploaded photos (relative paths resolve inside app/)
PHOTO_UPLOAD_DIR=uploads

# Optional: retention window for uploaded photos (seconds, max 180)
UPLOAD_RETENTION_SECONDS=180
# Optional: interval between cleanup sweeps (seconds, max 180)
UPLOAD_CLEANUP_INTERVAL_SECONDS=60
