# VolcEngine credentials (required)
VOLC_ACCESS_KEY_ID=
VOLC_SECRET_KEY=

# RTC credentials (required)
VOLC_RTC_APP_ID=
VOLC_RTC_APP_KEY=

# Speech service credentials
VOLC_ASR_APP_ID=
VOLC_TTS_APP_ID=
VOLC_TTS_APP_TOKEN=
VOLC_TTS_RESOURCE_ID=

# Custom LLM forwarding
# For docker-compose.web-volc.yml, point to the app service:
VOLC_LLM_URL=http://app:8081/chat-stream
# Must match CUSTOM_LLM_API_KEY in app/.env
VOLC_LLM_API_KEY=

# 👉 All non-sensitive tuning parameters now live in src/config.ts
