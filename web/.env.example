## Path: web/.env.example
VITE_AIGC_PROXY_HOST=http://localhost:3002

# Upload endpoint for captured photos (relative path or absolute URL)
VITE_UPLOAD_ENDPOINT=/api/upload
# Example for hosted storage service:
# VITE_UPLOAD_ENDPOINT=https://demo.emqx.io:8081/api/upload

# Optional: override MQTT WebSocket connection (defaults derive from page origin)
# VITE_MQTT_BROKER_URL=ws://localhost:8083/mqtt
# VITE_MQTT_USERNAME=emqx-mcp-webrtc-web-ui
# VITE_MQTT_PASSWORD=public
# VITE_MQTT_CONNECT_TIMEOUT=4000
# VITE_MQTT_RECONNECT_PERIOD=1000
# VITE_MQTT_PROTOCOL_VERSION=5
